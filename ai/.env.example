# AI 컨텍스트 환경변수 — 이 파일을 `.env` 로 복사해서 쓴다. `.env` 는 커밋하지 않는다.
#   cp .env.example .env
#
# 무엇을 여기 두고 무엇을 코드 기본값으로 둘지는
# backend/docs/conventions/environment.md 의 판단 기준을 따른다.
# 접두사 `AI_` 는 고정이다 (app/core/config.py 의 env_prefix).
# 이름이 어긋나면 로컬에서는 조용히 기본값으로 뜨고 배포에서 터진다.

# --- 실행 환경 ---
# local | dev | prod
# local 에서만 AI_INTERNAL_API_KEY 없이 기동할 수 있다 (내부 호출 검증이 꺼진다).
AI_ENV=local

# --- 바인딩 ---
# 백엔드(8080)·프론트엔드(3000)와 겹치지 않게 8000 을 쓴다.
# 포트를 바꾸려면 BE/FE 이슈와 값을 맞춰야 한다.
AI_HOST=0.0.0.0
AI_PORT=8000

# --- 로깅 ---
# DEBUG | INFO | WARNING | ERROR
AI_LOG_LEVEL=INFO
# text | json. json 은 한 줄 JSON(필드 이름은 backend logstash 포맷과 같다)이며 루트 compose 가 켠다.
# 로컬 uv run 개발은 text 그대로 둔다.
AI_LOG_FORMAT=text

# --- 내부 호출 인증 ---
# Spring 백엔드 ↔ AI 서비스 공유 시크릿. 요청의 `X-Internal-Api-Key` 헤더와 대조한다.
# 이 서비스는 사용자 JWT 를 검증하지 않는다. 이 키가 유일한 인증 수단이다.
# 값 생성: uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
# 로컬에서는 비워둘 수 있다 (검증 비활성 + 기동 시 WARNING).
# dev/prod 에서 비어 있으면 기동이 실패한다 — 의도된 동작이다.
AI_INTERNAL_API_KEY=

# --- CORS ---
# 콤마로 구분한다. 예: http://localhost:3000,https://<배포 도메인>
# **비워두면 CORS 미들웨어를 아예 붙이지 않는다.** 현재는 Spring 백엔드만 호출하는 내부
# 서비스라 비우는 게 맞다. 프론트엔드가 직접 호출하기로 정해지면 그때 origin 을 채우고,
# FE 이슈의 허용 origin 과 값을 맞춘다 → docs/decisions-later.md
AI_CORS_ALLOW_ORIGINS=

# --- 모델 가중치 ---
# 가중치 파일을 읽을 로컬 디렉터리 경로. 예: ./models 또는 D:/weights
# **가중치는 저장소에 커밋하지 않는다** (.gitignore 가 *.pt·*.bin·*.safetensors·*.onnx 등을 막는다).
# 비워두면 모델을 로드하지 않는다. S3·HuggingFace Hub 로 받을지는 아직 미정이다.
AI_MODEL_DIR=

# --- 헤드라인 생성 (SSAFY GMS 게이트웨이) ---
# 복기 리포트의 헤드라인 한 줄을 LLM 으로 만든다. 나머지 문구는 지금처럼 블록에서 고른다.
#
# **키만 채우면 켜진다.** 비워두면 헤드라인도 블록 문장을 쓴다 (지금까지의 동작).
# 발급: https://gms.ssafy.io — 토큰 사용량만큼 크레딧이 차감된다.
# 값은 절대 커밋하지 않고 로그에도 남기지 않는다.
AI_LLM_API_KEY=

# 키와 무관하게 켜고 끄고 싶을 때만 쓴다. 비워두면 위의 키 유무로 정해진다.
# true 로 적어두고 키가 비어 있으면 기동이 실패한다 — 조용히 블록 문장으로 돌아가는 것을
# 막기 위해서다 (키 이름 오타도 여기 걸린다).
AI_LLM_ENABLED=

# 주소·모델·타임아웃·동시 호출 수는 app/core/config.py 의 기본값을 쓴다.
# 기본 모델은 gpt-5-mini 다. 더 싸게 돌리려면 AI_LLM_MODEL=gpt-5-nano (단가 약 1/5, 문장 품질은 떨어진다).
