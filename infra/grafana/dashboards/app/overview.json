    {
      "type": "timeseries",
      "title": "backend p95 지연 (uri 별)",
      "description": "histogram_quantile 은 _bucket 이 있어야 한다 — compose 의 MANAGEMENT_METRICS_DISTRIBUTION_PERCENTILESHISTOGRAM_… 가 켠다.",
      "id": 7,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 10
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
