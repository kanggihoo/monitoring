// 수집기 하나가 로그·메트릭·트레이스를 모두 받는다. 지금은 로그만.
// 파이프라인 그림: http://127.0.0.1:12345

// ── 로그: stdout(JSON) → Docker → socket-proxy → 여기 → Loki ─────────────────

// logging.collect=true 라벨을 단 컨테이너만 가져간다 (수집 선언).
discovery.docker "logs" {
  host             = "tcp://socket-proxy:2375"
  refresh_interval = "10s"
  filter {
    name   = "label"
    values = ["logging.collect=true"]
  }
}

// 라벨은 값 종류가 적은 것만 둔다: service(여기) · env(loki.write) · level(loki.process).
discovery.relabel "logs" {
  targets = []
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }
}

loki.source.docker "containers" {
  host          = "tcp://socket-proxy:2375"
  targets       = discovery.docker.logs.targets
  relabel_rules = discovery.relabel.logs.rules
  forward_to    = [loki.process.app.receiver]
}

loki.process "app" {
  // backend(Spring logstash)와 ai(JsonFormatter)가 같은 필드 이름을 쓴다.
  stage.json {
    expressions = { level = "", message = "", trace_id = "", span_id = "" }
  }

  // 헬스체크 요청 로그는 버린다 (ai 컨테이너 HEALTHCHECK 가 30초마다 /health 를 부른다).
  stage.drop {
    source              = "message"
    expression          = ".*\"GET /(health|actuator)[^\"]*\".*"
    drop_counter_reason = "healthcheck"
  }

  stage.labels {
    values = { level = "" }
  }

  // 트레이스 ID 는 값 종류가 무한하다 — 라벨로 올리면 스트림이 폭발한다.
  stage.structured_metadata {
    values = { trace_id = "", span_id = "" }
  }

  forward_to = [loki.write.default.receiver]
}

loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
  external_labels = { env = "local" }
}

// ── 트레이스: 앱 → OTLP http/protobuf :4318 → tail sampling → batch → Tempo ──────

otelcol.receiver.otlp "default" {
  http {
    endpoint = "0.0.0.0:4318"
  }
  output {
    traces = [otelcol.processor.tail_sampling.default.input]
  }
}

// 정책은 OR 이다 — 하나라도 맞으면 남긴다. 어디에도 안 맞는 것이 빈 폴링 트레이스다:
// 리플레이 폴러가 100ms 마다 만드는 루트 span 하나짜리 (할 일이 없으면 DB 도 열지 않는다).
otelcol.processor.tail_sampling "default" {
  // 트레이스의 span 이 다 모일 때까지 기다리는 시간. 틱 처리는 100ms 안팎이다.
  decision_wait = "5s"

  policy {
    name = "errors"
    type = "status_code"
    status_code {
      status_codes = ["ERROR"]
    }
  }

  // 틱 트레이스: 체결·평가·랭킹 리스너의 JDBC·Redis span 이 달린다.
  policy {
    name = "has-children"
    type = "span_count"
    span_count {
      min_spans = 2
    }
  }

  // API 트레이스는 span 하나여도 남긴다 (401 로 끝난 요청 등).
  policy {
    name = "server-requests"
    type = "ottl_condition"
    ottl_condition {
      error_mode = "ignore"
      span      = ["kind == SPAN_KIND_SERVER"]
    }
  }

  output {
    traces = [otelcol.processor.batch.default.input]
  }
}

otelcol.processor.batch "default" {
  output {
    traces = [otelcol.exporter.otlp.tempo.input]
  }
}

otelcol.exporter.otlp "tempo" {
  client {
    endpoint = "tempo:4317"
    tls {
      insecure = true
    }
  }
}
