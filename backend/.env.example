# 로컬 개발은 이 파일의 기본값 그대로 동작한다. 실제 값은 .env 에 두고 커밋하지 않는다.
# 설정값을 .env 와 application.yml 중 어디에 둘지는 docs/conventions/environment.md 참조.

# PostgreSQL — compose.yml 과 application.yml 이 같은 이름을 참조한다.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ssafydb
POSTGRES_USER=ssafy
POSTGRES_PASSWORD=ssafy

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Spring (compose 로 앱까지 띄울 때 호스트에 노출할 포트)
APP_PORT=8080

# Google OAuth — https://console.cloud.google.com 에서 발급.
# 노출되면 즉시 콘솔에서 폐기(reset)하고 재발급한다.
#
# 이 두 값이 비어 있으면 애플리케이션이 기동하지 않는다 ("clientId cannot be empty").
# 값을 채우기 전까지는 DB·Redis 만 띄워두고 프론트 개발을 진행한다.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google 콘솔의 "승인된 리디렉션 URI" 와 문자 단위로 일치해야 한다.
# 어긋나면 redirect_uri_mismatch 로 로그인이 실패한다.
#
# 백엔드 오리진을 직접 쓴다. 프론트(:3000)를 거치지 않으므로 프록시 헤더에 의존하지 않는다.
# 쿠키는 포트를 구분하지 않으므로 :8080 이 심은 세션 쿠키가 :3000 에서도 전송된다.
# 배포에서는 nginx 가 받는 도메인으로 바꾼다 (https://<도메인>/api/login/oauth2/code/google).
GOOGLE_REDIRECT_URI=http://localhost:8080/api/login/oauth2/code/google

# 로그인 성공·실패 후 브라우저를 되돌려 보낼 프론트 주소.
# 경로는 붙이지 않는다 (scheme + host + port 까지).
# 성공하면 이 주소로, 실패하면 <이 주소>/login?error=login_failed 로 되돌린다.
APP_BASE_URL=http://localhost:3000


# WebSocket 핸드셰이크를 허용할 출처 목록 (쉼표 구분). **미설정이면 APP_BASE_URL 하나**라
# 평소에는 적을 일이 없다. 적는 경우는 공개 도메인을 갈아탈 때 하나뿐이다 — 옛 주소와 새
# 주소를 함께 열어 두면 이미 접속해 있던 탭의 실시간 연결이 배포 순간에 끊기지 않는다.
#   예) APP_ALLOWED_ORIGINS=https://flashback.my,https://j15a605.p.ssafy.io
# OAuth 복귀 주소는 함께 늘릴 수 없다. 로그인 성공 후 보낼 곳은 하나여야 하므로 그쪽은
# APP_BASE_URL 이 그대로 정하며, 전환일에 이 값을 새 도메인으로 바꾸는 것이 전환 그 자체다.
# APP_ALLOWED_ORIGINS=

# Kakao OAuth — https://developers.kakao.com 에서 발급.
# 콘솔에서 함께 해둘 것: 카카오 로그인 활성화, OpenID Connect 활성화(비활성이면 ID 토큰이
# 발급되지 않아 로그인이 성립하지 않는다), 닉네임 동의항목을 '필수 동의' 로 설정.
#
# GOOGLE_* 과 마찬가지로 비어 있으면 애플리케이션이 기동하지 않는다.

# SSAFY OAuth 
SSAFY_CLIENT_ID=
SSAFY_CLIENT_SECRET=

# SSAFY 콘솔에 등록한 Redirect URI 와 문자 단위로 일치해야 한다. 어긋나면 로그인이 실패한다.
#
# 콜백을 받는 것은 백엔드다 — 프론트(:3000)가 아니라 백엔드 오리진(:8080)을 그대로 적고,
# 같은 값을 SSAFY 콘솔에도 등록한다. 쿠키는 포트를 구분하지 않으므로 :8080 이 심은 세션
# 쿠키가 :3000 에서도 전송된다.
# 배포에서는 nginx 가 받는 도메인으로 바꾼다 (https://<도메인>/api/login/oauth2/code/ssafy).
SSAFY_REDIRECT_URI=http://localhost:8080/api/login/oauth2/code/ssafy

# 세션 유휴 만료. 마지막 요청 이후 이 시간 동안 요청이 없으면 만료된다.
# 값 형식은 Duration (예: 30m, 12h, 1d). 절대 만료는 두지 않는다 (ADR-0001).
SESSION_TIMEOUT=1d

# 테스트 지원 인프라 (IdP 를 거치지 않고 Test User 의 세션을 발급하는 경로) 스위치.
# 기본값은 꺼짐이고 미설정도 꺼짐이다. 배포 환경에서는 켜지 않는다.
# 켜면 테스트 로그인(부하 도구용)과 샌드박스(관리자의 USER 시점 확인용), 부하용 Test User
# 시딩이 한꺼번에 활성화된다. 스위치는 이것 하나뿐이다.
# 배포(dev·prod)에서는 이 스위치를 .env 가 아니라 deploy/compose.*.yml 이 준다 —
# 비밀이 아니면서 환경마다 갈리는 값이라 버전 관리되는 자리에 둔다. compose 의
# environment 가 env_file 을 이기므로 Secret file 에 넣어도 무시된다.
TEST_SUPPORT_ENABLED=false

# 위 기능이 켜졌을 때 테스트 로그인 호출자를 인증하는 키. 32자 미만이면 기동이 실패한다.
# 비밀값이므로 커밋하지 않는다. 생성:
#   openssl rand -hex 32
TEST_SUPPORT_API_KEY=

# --- 마켓 리플레이 재생 시계 ---
# 환경별 권장 조합 (이 두 값은 별개 스위치다):
#   dev            REPLAY_MODE=test        REPLAY_FIXTURE_ENABLED=false  실제 시즌 1 + 배속·예약 조작
#   운영           REPLAY_MODE=production  REPLAY_FIXTURE_ENABLED=false  고정 일정, 조작 경로 없음
#   테스트컨테이너   REPLAY_MODE=test        REPLAY_FIXTURE_ENABLED=true   검증용 시즌·4종목
#
# 재생 실행 환경. disabled | test | production 중 하나이며, 다른 값이면 기동이 실패한다.
# 미설정은 disabled 이고, 그때는 재생 경로도 폴러도 노출되지 않는다.
#   test       — 관리자 재생 조작(/api/v1/admin/replay)을 연다. 일차 전환이 야간 대기를
#                생략하므로 격리된 DB 에서만 쓴다.
#   production — 운영 개장 일정과 배속 1. 조작 API 를 제공하지 않으며, 시즌의
#                replay_state 초기화가 선행돼야 진행이 시작된다.
# 배포(dev·prod)에서는 이 값을 .env 가 아니라 deploy/compose.*.yml 이 준다 —
# 비밀이 아니면서 환경마다 갈리는 값이라 버전 관리되는 자리에 둔다.
REPLAY_MODE=disabled

# 검증용 픽스처(시즌 1 위의 4종목·12틱) 적재 스위치. 실행 환경과 별개이며 미설정은 꺼짐이다.
# 이 픽스처는 실제 시세가 적재된 DB 에서 기동을 거부하므로 테스트컨테이너 밖에서는 켜지 않는다.
REPLAY_FIXTURE_ENABLED=false

# 폐장·정산 발표 경계의 AI 복기 문구 생성. 미설정은 켜짐이라 운영 동작은 바뀌지 않는다.
# dev 에서 지점 이동(/api/v1/admin/replay/seek)으로 폐장을 반복해 지날 때만 끈다 —
# 모델 호출 비용이 쌓이는 것이 그 조작의 유일한 실질 비용이다. 배속과 달리 런타임에 바꿀 수
# 없다(빈 조건화). 끄면 리포트는 문구 없이 공개된다.
REPORT_AI_ENABLED=true

# 진행할 시즌. 재생 상태는 시즌당 1행이다.
REPLAY_SEASON_ID=1

# 도달한 틱·경계를 확인하는 주기(ms). 짧으면 고배속 진행이 촘촘해지고 DB 조회가 늘어난다.
# 하트비트와 다른 스레드에서 돌기 때문에 이 값이 WS 연결 유지에 영향을 주지는 않는다.
REPLAY_POLL_DELAY_MS=100

# --- AI 서비스 연동 ---
# 복기 리포트의 문구를 만드는 FastAPI 서비스. 브라우저는 이 주소를 부르지 않는다 —
# 폐장 정산 뒤 백엔드만 호출하고, 받은 문구는 백엔드가 저장한다.
#
# scheme + host + port 까지만 쓴다. 경로(/api/ai/...)는 호출부가 붙인다.
#
# 값이 없으면 기본값(http://localhost:8000)이 쓰인다. **배포에서 이 값을 빠뜨리면 백엔드가
# 자기 컨테이너의 8000 을 찔러** 두 번 실패하고, 리포트는 문구 없이 공개된다. 로그에 ERROR
# 한 줄만 남고 화면은 정상처럼 보이므로 발견이 늦다.
# 배포 값은 같은 도커 네트워크의 서비스 이름이다 (prod: http://ai:8000, dev: http://ai-dev:8000).
# 배포에서는 deploy/compose.*.yml 이 컨테이너 이름(ai-dev · ai)으로 준다.
AI_BASE_URL=http://localhost:8000

# 내부 호출 키. 요청의 X-Internal-Api-Key 헤더로 실린다. ai/.env 의 같은 이름과 **같은 값**
# 이어야 하고, 어긋나면 호출이 401 로 실패해 리포트가 문구 없이 공개된다.
# 로컬에서는 양쪽을 비워둘 수 있다 (AI 쪽 검증이 꺼지고 기동 시 WARNING). 생성:
#   openssl rand -hex 32
AI_INTERNAL_API_KEY=

# 아래 둘은 비밀도 아니고 환경마다 달라지지도 않아 application.yml 이 기본값을 갖는다
# (docs/conventions/environment.md 1절). 바꿀 일이 생겼을 때만 주석을 푼다.
#   AI_INDEX_PROXY_SYMBOL    시장 수익률을 대신할 종목 (기본 NQX)
#   ABSENCE_THRESHOLD_TICKS  부재로 보는 최소 틱 수 (기본 50 = 게임 50 거래일)
# AI_INDEX_PROXY_SYMBOL=NQX
# ABSENCE_THRESHOLD_TICKS=50

# --- scripts/replay-loader ---
# 적재 스크립트는 Spring 이 아니다. 설정은 자기 디렉터리에서 읽고, 그 파일이 없을 때만
# 이 파일의 POSTGRES_* 를 대신 읽는다 (scripts/load-replay.sh 의 폴백). 설정은 여기 있다:
#   backend/scripts/replay-loader/.env.example  (복사해서 .env 로 둔다)
